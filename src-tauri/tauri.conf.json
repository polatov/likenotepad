{
  "productName": "LikeNotepad.exe",
  "version": "0.1.0",
  "identifier": "me.polatov.notepad",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "LikeNotepad.exe",
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "log", "md", "markdown", "csv", "json", "xml", "ini", "conf", "cfg", "yaml", "yml"],
        "name": "Text Document",
        "description": "Text Document",
        "role": "Editor"
      }
    ],
    "resources": {
      "infoplist/": "./"
    }
  },
  "plugins": {}
}
